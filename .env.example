# Copy to .env and fill in. Never commit .env.

# NVIDIA Nemotron (OpenAI-compatible API key from build.nvidia.com)
NVIDIA_API_KEY=
# NVIDIA's hosted OpenAI-compatible endpoint (or a local server for the fallback)
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# Agent model; confirm the exact ID with GET /v1/models (A4)
NEMOTRON_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Optional embedding model for campaigns (A12) and classifier features (L7), e.g. nemotron-3.5-embed-1b
NEMOTRON_EMBED_MODEL=

# Google Gemini with Search grounding (key arrives Sunday morning; L4, L10)
GEMINI_API_KEY=
# Gemini model ID for grounded search
GEMINI_MODEL=

# DeepSeek: offline dataset generation only (A21); never sees a customer message
DEEPSEEK_API_KEY=
# DeepSeek's OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek model ID
DEEPSEEK_MODEL=

# Capital One Nessie mock bank API key
NESSIE_API_KEY=
# Nessie base URL
NESSIE_BASE_URL=http://api.nessieisreal.com

# Hugging Face token (A5)
HF_TOKEN=

# live, record or replay (record and replay cache, L1)
DEMO_MODE=live
# true serves the scaffold's mock API responses
USE_MOCKS=true
# Random secret used to hash personal phone numbers during redaction
PHONE_HASH_SALT=
# Backend port for this folder (main 8000, cc 8001, codex 8002, design 8003)
API_PORT=8000
# Frontend dev server port for this folder (main 5173, cc 5174, design 5175, codex 5176)
WEB_PORT=5173
